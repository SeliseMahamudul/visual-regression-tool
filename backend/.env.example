# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# SEC-11: the backend binds to loopback by default. Live mode drives a real
# browser to user-supplied URLs, so exposing this port to the LAN hands that
# capability to anyone on the network. Changing this is an explicit opt-in and
# requires TLS in front of it.
BIND_HOST=127.0.0.1

# AI Classification (Free - Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Jira Integration (optional)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token_here

# GitHub Integration (optional)
GITHUB_TOKEN=ghp_your_github_token_here

# Storage
UPLOADS_DIR=./uploads
RESULTS_DIR=./results

# Live mode (FR-63…FR-75). Requires: npx playwright install chromium
LIVE_MAX_SESSIONS=3
LIVE_IDLE_TIMEOUT_MS=900000
LIVE_DETACH_GRACE_MS=60000
LIVE_SCREENCAST_QUALITY=60
LIVE_VIEWPORT_WIDTH=1280
LIVE_VIEWPORT_HEIGHT=800
# SEC-10: comma-separated host globs, e.g. *.stage.corp,*.dev.corp,localhost
# Empty means any http(s) host is allowed. RFC1918 is deliberately permitted —
# staging lives there — but cloud metadata endpoints are always blocked.
LIVE_URL_ALLOWLIST=

# ─── Chat / expectation extraction (FR-57) ──────────────────────────────
# Deliberately separate from VISION_PROVIDER so chat traffic does not consume
# the Gemini free tier (15 RPM / 1,500 RPD). Chat is far chattier than the
# upload flow and must never starve classification.
# Options: mock (default, offline, no key) | groq | ollama
CHAT_PROVIDER=mock

# Groq — free tier, no credit card: https://console.groq.com/keys
# SEC-01/SEC-02: this is a secret. It belongs in backend/.env (gitignored),
# never here and never in a commit.
GROQ_API_KEY=
# Pinned, not a "-latest" alias — providers retire model names (gotcha #5).
# Diagnose a 404 with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — fully local, zero cost, zero key. Requires `ollama serve` running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
