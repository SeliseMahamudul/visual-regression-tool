{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // DOM is required because backend/src/live drives Playwright: page.evaluate
    // callbacks run in the browser realm and reference document/Element/Node.
    // playwright-service/tsconfig.json already does the same for the same reason.
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
